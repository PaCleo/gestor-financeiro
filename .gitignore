# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test tem apenas credenciais locais do docker-compose de teste (sem
# segredos reais) e precisa ser commitado para o Vitest rodar de forma
# reprodutivel em qualquer maquina/CI.
!.env.test
# .env.example documenta as chaves esperadas com valores vazios (Criterio
# de aceite #7 da TASK-001) - sem segredos reais, seguro para commitar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
