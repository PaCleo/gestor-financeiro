// Schema Prisma do Gestor Financeiro (TASK-001).
// Modelo de dados conforme docs/PREMISSA.md secao 5, com @relation explicitas
// para as FKs soltas do rascunho (bankItemId, accountId, recurringBillId,
// transactionId) e indices em Transaction.date / Transaction.accountId.
//
// TASK-002: onDelete tornado explicito em Account.bankItem (Cascade) e
// Transaction.account (Restrict) - politica de exclusao intencional para o
// fluxo de BankItem (ver lib/bank-item.ts). O Restrict em Transaction.account
// nao muda o comportamento no Postgres (ja era o default implicito do Prisma
// para relacao obrigatoria - confirmado via pg_constraint), por isso
// `prisma migrate dev` nao gerou uma nova migration para essa mudanca (ver
// TASK-002.md secao 6).
//
// TASK-004: BankItem ganha `executionStatus String` (obrigatorio, simetrico a
// `status`) - resolve o DT-009. A Pluggy expoe dois campos de estado
// distintos (`item.status` e `item.executionStatus`); um BankItem so e
// criado depois de buscar o Item de verdade na Pluggy (`fetchPluggyItem`),
// que sempre devolve os dois campos - nao ha caminho legitimo para persistir
// um BankItem sem `executionStatus` conhecido, por isso obrigatorio (nao
// `String?`) e correto pelo modelo, nao so mais facil de migrar.
//
// TASK-005: BankItem ganha `archivedAt DateTime?` (nullable, DT-013) -
// resolve o DT-002 (desativar um banco). Nullable por natureza (a maioria
// dos BankItems nunca sera arquivada) e tambem porque a tabela ja pode ter
// linhas quando a migration roda - `NOT NULL` sem default quebraria contra
// dado preexistente (mesma licao do DT-013).
//
// TASK-006 (sync de Accounts/Transactions, resolve DT-007/DT-008/DT-017):
// - Account ganha `balance Decimal? @db.Decimal(14, 2)` - NULLABLE (nao
//   `NOT NULL`/default): DT-013 (Account ja existe desde a TASK-001 e pode
//   ter linhas) + correto por natureza (uma Account manual, sem
//   pluggyAccountId, pode nunca ter saldo vindo da Pluggy).
// - Transaction ganha `status String @default("POSTED")` - NOT NULL com
//   default (DT-013 satisfeito pelo default, sem abrir mao de NOT NULL:
//   toda Transaction, real ou manual, tem status definido).
// - Nenhum campo de PII de `paymentData` (documentNumber/payer/receiver/
//   nomes/dados de conta de terceiros) e persistido - so
//   `Transaction.method` (ja existente) recebe `paymentData.paymentMethod`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BankItem {
  id              String    @id @default(cuid())
  pluggyItemId    String    @unique
  institution     String
  status          String
  executionStatus String
  lastSyncAt      DateTime?
  archivedAt      DateTime?
  accounts        Account[]
}

model Account {
  id              String   @id @default(cuid())
  pluggyAccountId String?  @unique
  bankItemId      String?
  bankItem        BankItem? @relation(fields: [bankItemId], references: [id], onDelete: Cascade)
  name            String
  type            String
  balance         Decimal? @db.Decimal(14, 2)
  transactions    Transaction[]
}

model Transaction {
  id                   String    @id @default(cuid())
  pluggyTransactionId  String?   @unique
  accountId            String
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date                 DateTime
  description          String
  amount               Decimal   @db.Decimal(14, 2)
  category             String?
  categoryOverride     String?
  source               String
  method                String?
  status               String    @default("POSTED")
  recurringBillId      String?
  recurringBill        RecurringBill? @relation(fields: [recurringBillId], references: [id])
  billInstance         RecurringBillInstance?

  @@index([date])
  @@index([accountId])
}

model RecurringBill {
  id           String   @id @default(cuid())
  name         String
  amount       Decimal  @db.Decimal(14, 2)
  dueDay       Int
  method       String
  active       Boolean  @default(true)
  instances    RecurringBillInstance[]
  transactions Transaction[]
}

model RecurringBillInstance {
  id              String        @id @default(cuid())
  recurringBillId String
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id])
  month           String
  status          String
  paidAmount      Decimal?      @db.Decimal(14, 2)
  transactionId   String?       @unique
  transaction     Transaction?  @relation(fields: [transactionId], references: [id])
}
