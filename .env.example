# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commitar credenciais reais - .env.local ja esta no .gitignore.

# Postgres local (sobe via `docker compose up -d`, ver docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor?schema=public"

# Credenciais do Dashboard da Pluggy (https://dashboard.pluggy.ai/).
# Usadas apenas no servidor - nunca prefixar com NEXT_PUBLIC_.
CLIENT_ID=""
CLIENT_SECRET=""
