# Ambiente usado pela suite de testes (npm test / npm run test:coverage).
# Aponta para o database de teste isolado (gestor_test), criado pelo
# docker/init-db/01-create-test-database.sql quando `docker compose up -d` roda.
# Credenciais aqui sao as mesmas do Postgres local de desenvolvimento
# (docker-compose.yml) - nao sao segredos reais, por isso este arquivo e
# commitado para reprodutibilidade do CI/outros devs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_test?schema=public"
CLIENT_ID=""
CLIENT_SECRET=""
